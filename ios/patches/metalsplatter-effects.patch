diff --git a/MetalSplatter/Sources/SplatEffectParameters.swift b/MetalSplatter/Sources/SplatEffectParameters.swift
new file mode 100644
index 0000000..177120f
--- /dev/null
+++ b/MetalSplatter/Sources/SplatEffectParameters.swift
@@ -0,0 +1,31 @@
+import Foundation
+
+/// Per-splat size, opacity and brightness effects evaluated in the vertex
+/// shader. Splat positions are untouched, so sorting is unaffected.
+///
+/// Keep in sync with ShaderCommon.h : SplatEffectParameters. Flags are 0 (off)
+/// or 1 (on); band distances are log(distance) in splat units from the camera.
+public struct SplatEffectParameters: Equatable, Sendable {
+    public var bandEnabled: Float = 0
+    public var bandLogNear: Float = 0
+    public var bandLogFar: Float = 0
+    public var bandSpacing: Float = 0
+    public var bandShift: Float = 0
+    public var bandEdgeFade: Float = 0
+    public var bandFrontWidth: Float = 1
+    public var bandBackWidth: Float = 1
+    public var bandFrontGrow: Float = 0
+    public var bandBackShrink: Float = 0
+    public var bandBrightness: Float = 0
+
+    public var peripheryEnabled: Float = 0
+    public var peripheryCosSharp: Float = 1
+    public var peripheryCosSoft: Float = 0
+    public var peripheryGrow: Float = 0
+    public var peripheryOpacity: Float = 1
+
+    /// All effects off.
+    public static let none = SplatEffectParameters()
+
+    public init() {}
+}
