diff --git a/MetalSplatter/Resources/SplatEffects.h b/MetalSplatter/Resources/SplatEffects.h
new file mode 100644
index 0000000..ac3ebd5
--- /dev/null
+++ b/MetalSplatter/Resources/SplatEffects.h
@@ -0,0 +1,63 @@
+#import "ShaderCommon.h"
+
+// Mirrors the Spark effect program in the parallax-window project
+// (mattercraft/splatBandGraph.ts and splatEffectGraph.ts); keep them in step.
+
+typedef struct
+{
+    float size;   // multiplies the splat's linear size
+    float alpha;  // multiplies its opacity
+    float glow;   // multiplies its colour
+} SplatEffectResult;
+
+/// 1 at `offset` 0, falling smoothly to 0 at `width`.
+inline float effectFalloff(float offset, float width) {
+    return 1 - smoothstep(0.0f, width, offset);
+}
+
+/// 0 at `offset` 0, peaking at 1 halfway to `width`, and 0 at `width` and beyond.
+inline float effectHump(float offset, float width) {
+    float x = clamp(offset / width, 0.0f, 1.0f);
+    return 4 * x * (1 - x);
+}
+
+/// Strength of a band centred at `centre`: 0 outside near..far, fading at the ends.
+inline float bandLifetime(SplatEffectParameters e, float centre) {
+    float fadeIn = smoothstep(e.bandLogNear, e.bandLogNear + e.bandEdgeFade, centre);
+    float fadeOut = smoothstep(e.bandLogFar - e.bandEdgeFade, e.bandLogFar, centre);
+    return fadeIn * (1 - fadeOut);
+}
+
+/// Band centres sit on a grid `bandSpacing` apart that slides outward by
+/// `bandShift`. A splat only needs the nearest band on each side: the one it is
+/// ahead of (whose front swells it) and the one it is behind (whose back shrinks it).
+inline void applyBand(SplatEffectParameters e, float distance, thread SplatEffectResult &r) {
+    float logDistance = log(distance);
+    float offset = logDistance - e.bandLogNear - e.bandShift;
+    float ahead = offset - e.bandSpacing * floor(offset / e.bandSpacing);
+    float behind = e.bandSpacing - ahead;
+    float bandBelow = bandLifetime(e, logDistance - ahead);
+    float bandAbove = bandLifetime(e, logDistance + behind);
+
+    float swell = effectHump(ahead, e.bandFrontWidth) * e.bandFrontGrow * bandBelow;
+    float trough = effectHump(behind, e.bandBackWidth) * e.bandBackShrink * bandAbove;
+    r.size *= max(1 + swell - trough, 0.0f);
+
+    float lit = max(effectFalloff(ahead, e.bandFrontWidth) * bandBelow,
+                    effectFalloff(behind, e.bandBackWidth) * bandAbove);
+    r.glow *= 1 + lit * e.bandBrightness;
+}
+
+/// `cosAngle` is the cosine of the angle between the view direction and the splat.
+inline void applyPeriphery(SplatEffectParameters e, float cosAngle, thread SplatEffectResult &r) {
+    float weight = 1 - smoothstep(e.peripheryCosSoft, e.peripheryCosSharp, cosAngle);
+    r.size *= 1 + weight * e.peripheryGrow;
+    r.alpha *= mix(1.0f, e.peripheryOpacity, weight);
+}
+
+inline SplatEffectResult evaluateSplatEffects(SplatEffectParameters e, float distance, float cosAngle) {
+    SplatEffectResult r = { 1, 1, 1 };
+    if (e.bandEnabled > 0.5f && e.bandSpacing > 0) applyBand(e, max(distance, 1e-3f), r);
+    if (e.peripheryEnabled > 0.5f) applyPeriphery(e, cosAngle, r);
+    return r;
+}
